# Wajib untuk login Google (Google Cloud Console > Credentials > OAuth client ID > Web application)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Opsional (ada nilai bawaan). Acak panjang, contoh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Apikey dev/owner (unlimited). Ganti di sini, jangan hardcode di repo publik
DEV_API_KEY=WanzzGantengBanget3369

# Akun dev dengan username "wanz": login di /dashboard (kolom email isi: wanz) + password ini.
# Opsional: sudah ada nilai bawaan di core/auth.js (repo private). Isi di sini untuk menimpa.
DEV_USERNAME=wanz
DEV_PASSWORD=

# Email Google yang juga jadi akun dev (unlimited) saat login pakai Google. Pisahkan koma
DEV_EMAILS=emailkamu@gmail.com

# Batas free per hari (default 500)
DAILY_LIMIT=500

# Wajib di Vercel (filesystem-nya tidak permanen). Gratis di upstash.com, atau pakai Vercel KV
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Di Pterodactyl tanpa Upstash, data akun disimpan di data/db.json
